# Paths left out of the deployed theme. `npm run build` copies the repo into
# build/foxtail/ with rsync --exclude-from=.deployignore, and every deploy
# (CI or manual) uploads that folder. A leading / anchors to the repo root.
# Dotfiles are always excluded.

# Build output folder itself
/build/

# Local scratch space and agent notes
/tmp/

# Dependencies and build tooling
node_modules/
/package.json
/package-lock.json
/gulpfile*.js
/wpgulp.config.js
/scripts/

# Redirect list sources (the build turns them into inc/redirects-map.php)
/redirects/

# Build sources (only the compiled assets/css and assets/js/*.min.js are loaded)
/assets/sass/
/assets/vendor/protocol/css/
/assets/js/custom/
/assets/js/vendor/
*.map

# Docs
/README.md
